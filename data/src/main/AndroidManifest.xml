<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      API 29-30: BLE scanning requires legacy Bluetooth permissions plus location.
      `maxSdkVersion` keeps them out of the merged manifest on API 31+.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Expedited work runs as a foreground service on API 29-30. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      API 31+: scanning only, we never connect. BLUETOOTH_CONNECT is deliberately absent.
      `neverForLocation` keeps the location permission out of the picture, which matters on a
      watch where every extra runtime prompt is painful.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      Self update. The app ships outside any store (see docs/updates.md), so it has to fetch its
      own releases: INTERNET to read the GitHub API and download the APK, REQUEST_INSTALL_PACKAGES
      to hand that APK to the platform installer. These are the only two permissions here that are
      not about scanning, and neither can be avoided while the distribution channel is a Releases
      page. No POST_NOTIFICATIONS on purpose: the updater never notifies, it stages silently.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application>
        <!--
          Receives the device list (including the advertisement keys) from the counterpart app over
          the Wear OS Data Layer. Both apps ship this service, so the sync works in both directions.
        -->
        <service
            android:name="de.universam.victron.data.sync.ConfigSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/victron" />
            </intent-filter>
        </service>

        <!-- Where a committed install session reports back; local to the app. -->
        <receiver
            android:name="de.universam.victron.data.update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
