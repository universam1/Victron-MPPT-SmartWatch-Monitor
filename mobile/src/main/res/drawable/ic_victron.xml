<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon: a 240° power arc with glow halo on a navy gradient background.
  Matches the dashboard visual language — the arc is the brand.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Navy gradient background (simulated with two rects) -->
    <path
        android:fillColor="#0A1628"
        android:pathData="M0,0h108v54H0z" />
    <path
        android:fillColor="#0D1F3C"
        android:pathData="M0,54h108v54H0z" />

    <!-- Outer glow — wide, faint golden halo -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#40FFC531"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M25.5,82.5 A33,33 0 1,1 82.5,82.5" />

    <!-- Inner glow — medium, brighter -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#80FFC531"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M25.5,82.5 A33,33 0 1,1 82.5,82.5" />

    <!-- Main arc — crisp solar yellow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFC531"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M25.5,82.5 A33,33 0 1,1 82.5,82.5" />

    <!-- Track arc — the unfilled portion hint (subtle) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A2332"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M25.5,82.5 A33,33 0 0,1 82.5,82.5" />

    <!-- Lightning bolt / power symbol in center -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,38 L44,54 L50,54 L48,70 L58,50 L52,50 L56,38 Z" />
</vector>
